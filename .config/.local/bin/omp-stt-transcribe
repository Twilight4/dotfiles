#!/home/twilight/.config/.local/share/uv/tools/sherpa-onnx/bin/python
# Transcribe a 16 kHz mono WAV to text with the OMP-cached Parakeet TDT model.
#
# OMP's hold-Space STT is a TUI-only feature (wired into the interactive
# editor's input loop).  agent-shell runs `omp acp' (headless ACP protocol),
# which never starts the TUI, so STT cannot fire there.  This script reuses
# the exact same on-device Parakeet model OMP's TUI uses, driven standalone
# via sherpa-onnx, so dictation in agent-shell matches the TUI experience.
#
# Usage:   omp-stt-transcribe <recording.wav>
# Depends: `uv tool install sherpa-onnx`  (provides the interpreter above)
# Model:   ~/.omp/agent/cache/tiny-models/csukuangfj/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
import os, sys, wave, array, sherpa_onnx

MODEL = os.path.expanduser(
    "~/.omp/agent/cache/tiny-models/csukuangfj/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
)
wav_path = sys.argv[1] if len(sys.argv) > 1 else "/tmp/omp-dictate.wav"

rec = sherpa_onnx.OfflineRecognizer.from_transducer(
    encoder=f"{MODEL}/encoder.int8.onnx",
    decoder=f"{MODEL}/decoder.int8.onnx",
    joiner=f"{MODEL}/joiner.int8.onnx",
    tokens=f"{MODEL}/tokens.txt",
    model_type="nemo_transducer",
    num_threads=4,
    decoding_method="greedy_search",
    provider="cpu",
)

with wave.open(wav_path) as f:
    rate = f.getframerate()
    raw = f.readframes(f.getnframes())
samples = [s / 32768.0 for s in array.array("h", raw)]

stream = rec.create_stream()
stream.accept_waveform(rate, samples)
rec.decode_stream(stream)
sys.stdout.write(stream.result.text.strip())
sys.stdout.write("\n")
