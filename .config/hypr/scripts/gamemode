#!/usr/bin/env sh
# MIGRATION: `hyprctl keyword` is gone -> `hyprctl eval 'hl.config({...})'`.
# `drop_shadow` was restructured into `decoration.shadow.enabled`.
HYPRGAMEMODE=$(hyprctl getoption animations.enabled | awk 'NR==1{print $2}')

if [ "$HYPRGAMEMODE" = 1 ] ; then
    hyprctl eval 'hl.config({animations={enabled=false}, decoration={shadow={enabled=false}, blur={enabled=false}, rounding=0}, general={gaps_in=0, gaps_out=0, border_size=1}})' >/dev/null
    notify-send -t 3000 "Gamemode: On"
    exit
fi

hyprctl reload
notify-send -t 3000 "Gamemode: Off"
