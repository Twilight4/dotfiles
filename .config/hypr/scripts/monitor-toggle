#!/bin/bash
# Cycles monitor profiles: TV only -> Main only -> 2 Monitors -> TV only ...
# MIGRATION: was comment/uncomment of `monitor=` lines in workspaces.conf + reload.
# Now: writes the profile name to ~/.cache/hypr/monitor-profile, which monitors.lua
# reads at config load; then reloads so the new layout applies.
STATE="$HOME/.cache/hypr/monitor-profile"
MODES=("tv-only" "main-only" "two-monitors")
LABEL=("TV only" "Main only" "2 Monitors")

current=$(cat "$STATE" 2>/dev/null)
[ -z "$current" ] && current="main-only"

idx=0
for i in "${!MODES[@]}"; do [ "${MODES[$i]}" = "$current" ] && idx=$i && break; done
nidx=$(( (idx + 1) % ${#MODES[@]} ))
next="${MODES[$nidx]}"

mkdir -p "$(dirname "$STATE")"
echo "$next" > "$STATE"
hyprctl reload >/dev/null 2>&1
notify-send -u low -t 1500 "Monitor profile" "Switched to: ${LABEL[$nidx]}"
