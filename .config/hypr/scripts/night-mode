#!/bin/bash
# MIGRATION: `hyprctl keyword` is gone -> `hyprctl eval 'hl.config({...})'`.
# screen_shader still lives under decoration in 0.56.

# Check if night mode is currently on
CURRENT_SHADER=$(hyprctl getoption decoration.screen_shader | grep 'str:' | awk '{print $2}')

# Toggle between on and off
if [[ "$CURRENT_SHADER" == "[[EMPTY]]" || -z "$CURRENT_SHADER" ]]; then
    # Night mode is off, turn it on
    hyprctl eval 'hl.config({decoration={screen_shader="~/.config/hypr/shaders/flux.glsl"}})' >/dev/null
    notify-send -u low -t 4000 -i "$HOME/.config/mako/icons/night-mode.png" "Night mode: On"
else
    # Night mode is on, turn it off
    hyprctl eval 'hl.config({decoration={screen_shader="[[EMPTY]]"}})' >/dev/null
    notify-send -u low -t 4000 -i "$HOME/.config/mako/icons/night-mode.png" "Night mode: Off"
fi
