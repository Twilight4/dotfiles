#!/bin/bash
# MIGRATION: `hyprctl keyword` is gone -> `hyprctl eval 'hl.config({...})'`.
STATE=$(hyprctl -j getoption decoration.blur.passes | jq ".int")

if [ "${STATE}" == "4" ]; then
	hyprctl eval 'hl.config({decoration={blur={size=5, passes=2}}})' >/dev/null
  notify-send -t 3000 "Normal blur"
else
  hyprctl eval 'hl.config({decoration={blur={size=12, passes=4}}})' >/dev/null
	notify-send -t 3000 "Glassy blur"
fi
