#!/usr/bin/env sh
# MIGRATION: `hyprctl keyword X V` is removed in the Lua era. Runtime config
# changes now go through `hyprctl eval 'hl.config({...})'` (ephemeral, until reload).
# `drop_shadow` was restructured into `decoration.shadow.enabled`.
HYPRBLUR=$(hyprctl getoption decoration.blur.enabled | awk 'NR==1{print $2}')

if [ "$HYPRBLUR" = 1 ] ; then
    hyprctl eval 'hl.config({animations={enabled=false}, decoration={shadow={enabled=false}, blur={enabled=false}, rounding=0}, general={gaps_in=0, gaps_out=0, border_size=1}})' >/dev/null
    notify-send -t 3000 "Battery Saving: On"
    exit
fi

hyprctl reload
notify-send -t 3000 "Battery Saving: Off"
